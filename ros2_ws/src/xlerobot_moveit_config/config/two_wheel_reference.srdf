<?xml version="1.0" encoding="UTF-8"?>
<robot name="xlerobot_two_wheel_reference">
  <group name="right_arm">
    <chain base_link="right_arm_base_link" tip_link="right_arm_ee_link"/>
  </group>
  <group name="left_arm">
    <chain base_link="left_arm_base_link" tip_link="left_arm_ee_link"/>
  </group>
  <group name="right_gripper">
    <joint name="right_arm_gripper"/>
  </group>
  <group name="left_gripper">
    <joint name="left_arm_gripper"/>
  </group>
  <group name="head">
    <chain base_link="top_base_link" tip_link="head_tilt_link"/>
  </group>
  <group name="dual_arms">
    <group name="right_arm"/>
    <group name="left_arm"/>
  </group>

  <end_effector name="right_hand" parent_link="right_arm_ee_link"
    group="right_gripper" parent_group="right_arm"/>
  <end_effector name="left_hand" parent_link="left_arm_ee_link"
    group="left_gripper" parent_group="left_arm"/>

  <group_state name="home" group="right_arm">
    <joint name="right_arm_shoulder_pan" value="0.0"/>
    <joint name="right_arm_shoulder_lift" value="0.0"/>
    <joint name="right_arm_elbow_flex" value="0.0"/>
    <joint name="right_arm_wrist_flex" value="0.0"/>
    <joint name="right_arm_wrist_roll" value="0.0"/>
  </group_state>
  <group_state name="home" group="left_arm">
    <joint name="left_arm_shoulder_pan" value="0.0"/>
    <joint name="left_arm_shoulder_lift" value="0.0"/>
    <joint name="left_arm_elbow_flex" value="0.0"/>
    <joint name="left_arm_wrist_flex" value="0.0"/>
    <joint name="left_arm_wrist_roll" value="0.0"/>
  </group_state>
  <group_state name="home" group="head">
    <joint name="head_pan_joint" value="0.0"/>
    <joint name="head_tilt_joint" value="0.0"/>
  </group_state>
  <group_state name="open" group="right_gripper">
    <joint name="right_arm_gripper" value="1.65"/>
  </group_state>
  <group_state name="close" group="right_gripper">
    <joint name="right_arm_gripper" value="0.05"/>
  </group_state>
  <group_state name="open" group="left_gripper">
    <joint name="left_arm_gripper" value="1.65"/>
  </group_state>
  <group_state name="close" group="left_gripper">
    <joint name="left_arm_gripper" value="0.05"/>
  </group_state>

  <disable_collisions link1="base_link" link2="base_inertia_link" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="right_arm_base_link" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="left_arm_base_link" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="laser" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="top_base_link" reason="Adjacent"/>
  <disable_collisions link1="base_inertia_link" link2="right_arm_base_link" reason="Never"/>
  <disable_collisions link1="base_inertia_link" link2="left_arm_base_link" reason="Never"/>
  <disable_collisions link1="base_inertia_link" link2="laser" reason="Never"/>
  <disable_collisions link1="base_inertia_link" link2="top_base_link" reason="Never"/>

  <disable_collisions link1="top_base_link" link2="head_pan_link" reason="Adjacent"/>
  <disable_collisions link1="head_pan_link" link2="head_tilt_link" reason="Adjacent"/>
  <disable_collisions link1="top_base_link" link2="head_tilt_link" reason="Never"/>
  <disable_collisions link1="top_base_link" link2="right_arm_base_link" reason="Adjacent"/>
  <disable_collisions link1="top_base_link" link2="right_arm_shoulder_pan_link" reason="Never"/>
  <disable_collisions link1="top_base_link" link2="left_arm_base_link" reason="Adjacent"/>
  <disable_collisions link1="top_base_link" link2="left_arm_shoulder_pan_link" reason="Never"/>

  <disable_collisions link1="right_arm_base_link" link2="right_arm_shoulder_pan_link" reason="Adjacent"/>
  <disable_collisions link1="right_arm_shoulder_pan_link" link2="right_arm_shoulder_lift_link" reason="Adjacent"/>
  <disable_collisions link1="right_arm_shoulder_lift_link" link2="right_arm_elbow_flex_link" reason="Adjacent"/>
  <disable_collisions link1="right_arm_elbow_flex_link" link2="right_arm_wrist_flex_link" reason="Adjacent"/>
  <disable_collisions link1="right_arm_wrist_flex_link" link2="right_arm_fixed_jaw_link" reason="Adjacent"/>
  <disable_collisions link1="right_arm_fixed_jaw_link" link2="right_arm_moving_jaw_link" reason="Adjacent"/>
  <disable_collisions link1="right_arm_fixed_jaw_link" link2="right_arm_ee_link" reason="Adjacent"/>
  <disable_collisions link1="right_arm_shoulder_lift_link" link2="right_arm_fixed_jaw_link" reason="User"/>
  <disable_collisions link1="right_arm_shoulder_lift_link" link2="right_arm_moving_jaw_link" reason="User"/>
  <disable_collisions link1="right_arm_shoulder_lift_link" link2="right_arm_wrist_flex_link" reason="User"/>
  <disable_collisions link1="base_link" link2="right_arm_wrist_flex_link" reason="Never"/>
  <disable_collisions link1="base_link" link2="right_arm_fixed_jaw_link" reason="Never"/>
  <disable_collisions link1="base_link" link2="right_arm_moving_jaw_link" reason="Never"/>
  <disable_collisions link1="base_link" link2="right_arm_ee_link" reason="Never"/>

  <disable_collisions link1="left_arm_base_link" link2="left_arm_shoulder_pan_link" reason="Adjacent"/>
  <disable_collisions link1="left_arm_shoulder_pan_link" link2="left_arm_shoulder_lift_link" reason="Adjacent"/>
  <disable_collisions link1="left_arm_shoulder_lift_link" link2="left_arm_elbow_flex_link" reason="Adjacent"/>
  <disable_collisions link1="left_arm_elbow_flex_link" link2="left_arm_wrist_flex_link" reason="Adjacent"/>
  <disable_collisions link1="left_arm_wrist_flex_link" link2="left_arm_fixed_jaw_link" reason="Adjacent"/>
  <disable_collisions link1="left_arm_fixed_jaw_link" link2="left_arm_moving_jaw_link" reason="Adjacent"/>
  <disable_collisions link1="left_arm_fixed_jaw_link" link2="left_arm_ee_link" reason="Adjacent"/>
  <disable_collisions link1="left_arm_shoulder_lift_link" link2="left_arm_fixed_jaw_link" reason="User"/>
  <disable_collisions link1="left_arm_shoulder_lift_link" link2="left_arm_moving_jaw_link" reason="User"/>
  <disable_collisions link1="left_arm_shoulder_lift_link" link2="left_arm_wrist_flex_link" reason="User"/>
  <disable_collisions link1="base_link" link2="left_arm_wrist_flex_link" reason="Never"/>
  <disable_collisions link1="base_link" link2="left_arm_fixed_jaw_link" reason="Never"/>
  <disable_collisions link1="base_link" link2="left_arm_moving_jaw_link" reason="Never"/>
  <disable_collisions link1="base_link" link2="left_arm_ee_link" reason="Never"/>

  <disable_collisions link1="right_arm_base_link" link2="left_arm_base_link" reason="Never"/>
</robot>
