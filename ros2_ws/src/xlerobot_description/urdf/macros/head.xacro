<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="head_assembly" params="parent top_base_xyz">
  <link name="top_base_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="4.3542"/>
      <inertia ixx="0.0045" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.0045"/>
    </inertial>


    <visual name="top_base_link_visual1">
      <origin
        xyz="0.016 -0.006 -0.727"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://xlerobot_description/meshes/xlerobot_original/topbase1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark_grey">
      </material>
    </visual>

    <visual name="top_base_link_visual2">
      <origin
        xyz="0.016 -0.006 -0.727"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://xlerobot_description/meshes/xlerobot_original/topbase2.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="motor">
      </material>
    </visual>
    <collision name="top_base_link_collision_1">
      <origin xyz="0.016 -0.006 -0.727" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://xlerobot_description/meshes/xlerobot_original/topbase1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <collision name="top_base_link_collision_2">
      <origin xyz="0.016 -0.006 -0.727" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://xlerobot_description/meshes/xlerobot_original/topbase2.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>


  <joint name="top_base_joint" type="fixed">
    <origin rpy="0 0 0" xyz="${top_base_xyz}"/>
    <parent link="${parent}"/>
    <child link="top_base_link"/>
  </joint>



  <link name="head_pan_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="2.2556"/>
      <inertia ixx="0.0129" ixy="0.0002" ixz="0.0007" iyy="0.0095" iyz="-0.0" izz="0.0184"/>
    </inertial>
    <visual name="top_head_1">
      <origin
        xyz="0.194 -0.006 -0.73"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://xlerobot_description/meshes/xlerobot_original/tophead3.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark_grey">
      </material>
    </visual>
    <visual name="top_head_2">
      <origin
        xyz="0.194 -0.006 -0.73"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://xlerobot_description/meshes/xlerobot_original/tophead4.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="motor">
      </material>
    </visual>
    <collision name="head_pan_link_collision_1">
      <origin xyz="0.194 -0.006 -0.73" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://xlerobot_description/meshes/xlerobot_original/tophead3.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <collision name="head_pan_link_collision_2">
      <origin xyz="0.194 -0.006 -0.73" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://xlerobot_description/meshes/xlerobot_original/tophead4.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <joint name="head_pan_joint" type="revolute">
    <origin rpy="0 0 0" xyz="-0.178 0 0"/>
    <parent link="top_base_link"/>
    <child link="head_pan_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="0.32" lower="-1.57" upper="1.57" velocity="1.57"/>
  </joint>

  <link name="head_tilt_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.9087"/>
      <inertia ixx="0.0061" ixy="-0.0" ixz="0.0002" iyy="0.0014" iyz="-0.0001" izz="0.0061"/>
    </inertial>
    <visual name="top_head_5">
      <origin
        xyz="0.16265 -0.006 -1.16815"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://xlerobot_description/meshes/xlerobot_original/tophead5.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark_grey">
      </material>
    </visual>
    <visual name="top_head_6">
      <origin
        xyz="0.16265 -0.006 -1.16815"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://xlerobot_description/meshes/xlerobot_original/tophead6.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="motor">
      </material>
    </visual>
    <collision name="head_tilt_link_collision_1">
      <origin xyz="0.16265 -0.006 -1.16815" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://xlerobot_description/meshes/xlerobot_original/tophead5.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <collision name="head_tilt_link_collision_2">
      <origin xyz="0.16265 -0.006 -1.16815" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://xlerobot_description/meshes/xlerobot_original/tophead6.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <joint name="head_tilt_joint" type="revolute">
    <origin rpy="0 0 0" xyz="0.031 0 0.43815"/>
    <parent link="head_pan_link"/>
    <child link="head_tilt_link"/>
    <axis xyz="0 1 0"/>
    <limit effort="0.68" lower="-0.76" upper="1.45" velocity="1.57"/>
  </joint>
  </xacro:macro>
</robot>
